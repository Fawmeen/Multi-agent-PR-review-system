# AI-PR Review Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# ========== Application Settings ==========
# DEBUG mode - enable for development
DEBUG=False

# ========== OpenRouter API Configuration ==========
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model selection - using free tier model
# Other options: mistralai/mistral-7b-instruct, meta-llama/llama-2-70b-chat, etc.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# OpenRouter API base URL (usually doesn't need to change)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ========== GitHub API Configuration ==========
# Personal access token for GitHub API
# Create at: https://github.com/settings/tokens (needs "public_repo" scope)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub webhook secret (must match the secret configured in GitHub webhook settings)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here-xxxxxxxxxxxxxxxxxxxx

# ========== Tiger Cloud Database (TimescaleDB) ==========
# Connection string for TimescaleDB/PostgreSQL database
# Format: postgresql+asyncpg://user:password@host:port/database
TIGER_DATABASE_URL=postgresql+asyncpg://tsdbadmin:password@your-timescale-host.tsdb.cloud:port/tsdb

# Connection pool settings
TIGER_POOL_SIZE=10
TIGER_POOL_OVERFLOW=5

# ========== Upstash Redis Configuration ==========
# Redis URL for job queue (ARQ)
# Get free Redis from: https://upstash.com
UPSTASH_REDIS_URL=rediss://default:password@your-upstash-host.upstash.io:6379

# ========== Application Metadata ==========
APP_NAME=AI-PR Review Agent
APP_VERSION=0.1.0

# ========== CORS Configuration ==========
# Allowed hosts for CORS (comma-separated)
ALLOWED_HOSTS=*
